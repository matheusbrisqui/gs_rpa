<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PassoLivreRPA" targetNamespace="https://github.com/passo-livre/rpa">
<bpmn:process id="Process_RelatoAoChamado" name="Passo Livre - do relato ao chamado" isExecutable="false">
<bpmn:startEvent id="inicio" name="Início agendado (a cada hora)"><bpmn:outgoing>f01</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:startEvent>
<bpmn:serviceTask id="t_saude" name="Verificar se a API do MVP está no ar"><bpmn:incoming>f01</bpmn:incoming><bpmn:outgoing>f02</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_api" name="API responde?"><bpmn:incoming>f02</bpmn:incoming><bpmn:outgoing>f03</bpmn:outgoing><bpmn:outgoing>f05</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_aborta" name="Registrar falha após 3 tentativas"><bpmn:incoming>f03</bpmn:incoming><bpmn:outgoing>f04</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="fim_erro" name="Fim com erro (código 2)"><bpmn:incoming>f04</bpmn:incoming><bpmn:errorEventDefinition/></bpmn:endEvent>
<bpmn:serviceTask id="t_retorno" name="Ler arquivo de retorno da prefeitura"><bpmn:incoming>f05</bpmn:incoming><bpmn:outgoing>f06</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_arquivo" name="Arquivo válido?"><bpmn:incoming>f06</bpmn:incoming><bpmn:outgoing>f07</bpmn:outgoing><bpmn:outgoing>f08</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_rejeita" name="Mover para rejeitados e registrar"><bpmn:incoming>f07</bpmn:incoming><bpmn:outgoing>f09</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_resolve" name="Marcar relatos concluídos como resolvidos"><bpmn:incoming>f08</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_busca" name="Buscar relatos novos e pontos de ônibus"><bpmn:incoming>f09</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_loop" name="Há relato a processar?"><bpmn:incoming>f11</bpmn:incoming><bpmn:incoming>f23</bpmn:incoming><bpmn:incoming>f24</bpmn:incoming><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="t_valida" name="Validar dados do relato"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="g_valido" name="Válido?"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="t_dup" name="Procurar relato igual em aberto (até 20 m)"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="g_dup" name="Duplicado?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="t_prio" name="Definir prioridade (R1, R2 ou R3)"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:serviceTask id="t_endereco" name="Buscar endereço (se falhar, segue sem)"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_encaminha" name="Gerar protocolo, atualizar MVP e gravar chamado"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_invalido" name="Marcar relato como inválido"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_marca_dup" name="Marcar como duplicado do original"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_resumo" name="Gravar logs, auditoria e resumo"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="fim" name="Fim"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f01" sourceRef="inicio" targetRef="t_saude"/>
<bpmn:sequenceFlow id="f02" sourceRef="t_saude" targetRef="g_api"/>
<bpmn:sequenceFlow id="f03" sourceRef="g_api" targetRef="t_aborta" name="Não"/>
<bpmn:sequenceFlow id="f04" sourceRef="t_aborta" targetRef="fim_erro"/>
<bpmn:sequenceFlow id="f05" sourceRef="g_api" targetRef="t_retorno" name="Sim"/>
<bpmn:sequenceFlow id="f06" sourceRef="t_retorno" targetRef="g_arquivo"/>
<bpmn:sequenceFlow id="f07" sourceRef="g_arquivo" targetRef="t_rejeita" name="Não"/>
<bpmn:sequenceFlow id="f08" sourceRef="g_arquivo" targetRef="t_resolve" name="Sim"/>
<bpmn:sequenceFlow id="f09" sourceRef="t_rejeita" targetRef="t_busca"/>
<bpmn:sequenceFlow id="f10" sourceRef="t_resolve" targetRef="t_busca"/>
<bpmn:sequenceFlow id="f11" sourceRef="t_busca" targetRef="g_loop"/>
<bpmn:sequenceFlow id="f12" sourceRef="g_loop" targetRef="t_valida" name="Sim"/>
<bpmn:sequenceFlow id="f13" sourceRef="g_loop" targetRef="t_resumo" name="Não"/>
<bpmn:sequenceFlow id="f14" sourceRef="t_resumo" targetRef="fim"/>
<bpmn:sequenceFlow id="f15" sourceRef="t_valida" targetRef="g_valido"/>
<bpmn:sequenceFlow id="f16" sourceRef="g_valido" targetRef="t_dup" name="Sim"/>
<bpmn:sequenceFlow id="f17" sourceRef="g_valido" targetRef="t_invalido" name="Não"/>
<bpmn:sequenceFlow id="f18" sourceRef="t_dup" targetRef="g_dup"/>
<bpmn:sequenceFlow id="f19" sourceRef="g_dup" targetRef="t_prio" name="Não"/>
<bpmn:sequenceFlow id="f20" sourceRef="g_dup" targetRef="t_marca_dup" name="Sim"/>
<bpmn:sequenceFlow id="f21" sourceRef="t_prio" targetRef="t_endereco"/>
<bpmn:sequenceFlow id="f22" sourceRef="t_endereco" targetRef="t_encaminha"/>
<bpmn:sequenceFlow id="f23" sourceRef="t_encaminha" targetRef="g_loop"/>
<bpmn:sequenceFlow id="f24" sourceRef="t_invalido" targetRef="g_loop"/>
<bpmn:sequenceFlow id="f25" sourceRef="t_marca_dup" targetRef="g_loop"/>
<bpmn:textAnnotation id="nota_falhas"><bpmn:text>Falha em um relato: registra o erro, mantém o relato como novo e passa ao próximo. Duas quedas seguidas da API ou token recusado encerram o lote com erro.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="assoc_nota" sourceRef="t_encaminha" targetRef="nota_falhas"/>
</bpmn:process>
