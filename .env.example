# Copie para .env e ajuste. O .env NUNCA vai para o repositório.
# O mesmo arquivo serve ao aplicativo (mvp/) e ao robô (src/).

# ---- Compartilhado
# Token que autoriza o robô a alterar relatos. Com valor, o aplicativo exige o cabeçalho
# X-Automation-Token e o robô o envia. Vazio = sem proteção (só para desenvolvimento).
AUTOMATION_TOKEN=

# ---- Aplicativo
DATABASE_URL=sqlite:///./passolivre.db
SEED_DEMO=true
HASH_SALT=troque-este-salt

# ---- Robô
PASSOLIVRE_API_URL=http://127.0.0.1:8000

# Pastas (relativas à raiz do repositório ou absolutas)
RPA_ENTRADA_DIR=entrada
RPA_SAIDA_DIR=saida
RPA_LOGS_DIR=logs

# Regras de negócio
RPA_RAIO_DUPLICADO_M=20
RPA_JANELA_DUPLICADO_DIAS=30
RPA_RAIO_PONTO_M=60

# Endereço dos relatos (deixe GEOCODER_URL vazio para desligar)
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_INTERVALO_S=1.1

# Resiliência
RPA_HTTP_TENTATIVAS=3
RPA_HTTP_ESPERA_S=2
RPA_HTTP_TIMEOUT_S=10
